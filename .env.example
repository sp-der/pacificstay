NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose this value to the browser or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout. Server-only keys entered by the Stripe owner in hosting settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional reservation email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Exact trusted origin. The root domain redirects to this canonical www host.
# Never derive payment redirects from an incoming Host header.
NEXT_PUBLIC_SITE_URL=https://www.pacificstayproperties.com

# Airbnb's private iCal feed is stored in Supabase's private integration store,
# not in public source control or client-side environment variables.

# Optional: set these only after the property exists in the published
# Pacific Stay Hostaway Booking Website and its checkout has been verified.
# Beach Baby is already mapped to listing ID 591608.
NEXT_PUBLIC_HOSTAWAY_CHESTNUT_LISTING_ID=
NEXT_PUBLIC_HOSTAWAY_CASA_LISTING_ID=
