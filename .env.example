NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose this value to the browser or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Airbnb exported iCal URL for Chestnut By the Sea. Keep the token private.
AIRBNB_ICAL_URL=

# Random secret used to protect the Airbnb calendar sync endpoint.
CRON_SECRET=

# Stripe Checkout: server-only keys, entered by the Stripe owner in hosting settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact trusted origin; never derive payment redirects from an incoming Host header.
NEXT_PUBLIC_SITE_URL=https://pacificstay.vercel.app
